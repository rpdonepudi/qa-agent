{
  "name": "qa-agent",
  "version": "0.1.0",
  "description": "AI QA agent: explores a web app, writes Playwright tests, runs them, self-heals, and reports.",
  "scripts": {
    "build": "tsc && cp src/ui.html dist/ui.html",
    "start": "node dist/server.js",
    "qa": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "demo": "node examples/demo-app/serve.mjs",
    "test": "node test/offline-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@playwright/test": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "bin": {
    "qa-agent": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  }
}
