# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Strongly recommended when the web UI is reachable by anyone else: a long random string.
# The UI asks for it once; API calls send it as "Authorization: Bearer <token>".
QA_AGENT_TOKEN=

# Optional
# QA_AGENT_MODEL=claude-opus-5-5
# QA_AGENT_EFFORT=high          # low | medium | high | xhigh | max
# QA_MAX_CONCURRENT=1           # runs at the same time; each one drives a browser
# PORT=3000
